    " \"cells\": [\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"# 🧠 Détection & Classification des Stades de Tumeurs Cérébrales\\n\",\n",
    "    \"## Pipeline Deep Learning — Google Colab (GPU T4)\\n\",\n",
    "    \"\\n\",\n",
    "    \"**Étapes :**\\n\",\n",
    "    \"1. Installation des dépendances\\n\",\n",
    "    \"2. Téléchargement du dataset Kaggle (Brain Tumor MRI)\\n\",\n",
    "    \"3. Remapping 4 classes → Stades WHO (0, I, II, III/IV)\\n\",\n",
    "    \"4. Entraînement CNN Baseline (128×128, Focal Loss)\\n\",\n",
    "    \"5. Transfer Learning EfficientNetB0 (224×224, 2 phases)\\n\",\n",
    "    \"6. Évaluation clinique (Recall, AUC, F2-Score)\\n\",\n",
    "    \"7. Grad-CAM (XAI — Explicabilité)\\n\",\n",
    "    \"8. Téléchargement du modèle `.keras`\\n\",\n",
    "    \"\\n\",\n",
    "    \"> **Note** : Ce notebook est conçu pour s'exécuter sur Google Colab avec GPU T4.  \\n\",\n",
    "    \"> Activez le GPU : Runtime → Change runtime type → GPU\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# ── 1. Installation des dépendances ────────────────────────────────────────\\n\",\n",
    "    \"!pip install -q kaggle tensorflow>=2.12 opencv-python-headless scikit-learn \\\\\\n\",\n",
    "    \"               matplotlib seaborn tqdm Pillow scipy\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# ── 2. Configuration Kaggle API ────────────────────────────────────────────\\n\",\n",
    "    \"import os\\n\",\n",
    "    \"from google.colab import files\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"Uploadez votre fichier kaggle.json: Kaggle → Account → API → Create New Token\\\")\\n\",\n",
    "    \"uploaded = files.upload()\\n\",\n",
    "    \"\\n\",\n",
    "    \"os.makedirs('/root/.kaggle', exist_ok=True)\\n\",\n",
    "    \"!mv kaggle.json /root/.kaggle/\\n\",\n",
    "    \"!chmod 600 /root/.kaggle/kaggle.json\\n\",\n",
    "    \"print('[OK] Kaggle API configurée')\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# ── 3. Téléchargement du dataset ───────────────────────────────────────────\\n\",\n",
    "    \"!mkdir -p /content/data/raw\\n\",\n",
    "    \"!kaggle datasets download -d masoudnickparvar/brain-tumor-mri-dataset \\\\\\n\",\n",
    "    \"    -p /content/data/raw --unzip\\n\",\n",
    "    \"\\n\",\n",
    "    \"import os\\n\",\n",
    "    \"for split in ['Training', 'Testing']:\\n\",\n",
    "    \"    path = f'/content/data/raw/{split}'\\n\",\n",
    "    \"    if os.path.isdir(path):\\n\",\n",
    "    \"        for cls in os.listdir(path):\\n\",\n",
    "    \"            n = len(os.listdir(f'{path}/{cls}'))\\n\",\n",
    "    \"            print(f'  {split}/{cls}: {n} images')\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# ── 4. Clone du dépôt projet ───────────────────────────────────────────────\\n\",\n",
    "    \"import sys, os\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Option A : depuis GitHub\\n\",\n",
    "    \"# !git clone https://github.com/votre-user/DeepLearningP1.git /content/DeepLearningP1\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Option B : créer et uploader les fichiers src\\n\",\n",
    "    \"os.makedirs('/content/DeepLearningP1/src', exist_ok=True)\\n\",\n",
    "    \"os.makedirs('/content/DeepLearningP1/models', exist_ok=True)\\n\",\n",
    "    \"os.makedirs('/content/DeepLearningP1/reports/gradcam', exist_ok=True)\\n\",\n",
    "    \"os.makedirs('/content/DeepLearningP1/data', exist_ok=True)\\n\",\n",
    "    \"\\n\",\n",
    "    \"os.chdir('/content/DeepLearningP1')\\n\",\n",
    "    \"sys.path.insert(0, 'src')\\n\",\n",
    "    \"print('[OK] Répertoire de travail :', os.getcwd())\\n\",\n",
    "    \"print('Uploadez maintenant les fichiers src/*.py via Files tab ou files.upload()')\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# ── 5. Remapping du dataset (4 classes WHO) ────────────────────────────────\\n\",\n",
    "    \"import shutil\\n\",\n",
    "    \"from pathlib import Path\\n\",\n",
    "    \"\\n\",\n",
    "    \"TRAIN_DIR  = Path('/content/data/raw/Training')\\n\",\n",
    "    \"TEST_DIR   = Path('/content/data/raw/Testing')\\n\",\n",
    "    \"STAGED_DIR = Path('data/staged_4classes')\\n\",\n",
    "    \"\\n\",\n",
    "    \"MAPPING = {\\n\",\n",
    "    \"    'notumor':    'stage_0',\\n\",\n",
    "    \"    'meningioma': 'stage_1',\\n\",\n",
    "    \"    'pituitary':  'stage_2',\\n\",\n",
    "    \"    'glioma':     'stage_3',\\n\",\n",
    "    \"}\\n\",\n",
    "    \"\\n\",\n",
    "    \"if STAGED_DIR.exists():\\n\",\n",
    "    \"    shutil.rmtree(STAGED_DIR)\\n\",\n",
    "    \"STAGED_DIR.mkdir(parents=True)\\n\",\n",
    "    \"for s in ['stage_0', 'stage_1', 'stage_2', 'stage_3']:\\n\",\n",
    "    \"    (STAGED_DIR / s).mkdir()\\n\",\n",
    "    \"\\n\",\n",
    "    \"total = 0\\n\",\n",
    "    \"for src_dir in [TRAIN_DIR, TEST_DIR]:\\n\",\n",
    "    \"    for orig_cls, target_stage in MAPPING.items():\\n\",\n",
    "    \"        src_path = src_dir / orig_cls\\n\",\n",
    "    \"        if not src_path.exists():\\n\",\n",
    "    \"            continue\\n\",\n",
    "    \"        imgs = list(src_path.glob('*.jpg'))\\n\",\n",
    "    \"        for img in imgs:\\n\",\n",
    "    \"            shutil.copy(img, STAGED_DIR / target_stage / img.name)\\n\",\n",
    "    \"        total += len(imgs)\\n\",\n",
    "    \"        print(f'  {orig_cls:15s} -> {target_stage}  ({len(imgs)} images)')\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f'\\\\n[OK] Remapping terminé : {total} images')\\n\",\n",
    "    \"for s in ['stage_0', 'stage_1', 'stage_2', 'stage_3']:\\n\",\n",
    "    \"    n = len(list((STAGED_DIR / s).glob('*.jpg')))\\n\",\n",
    "    \"    bar = '█' * (n // 50)\\n\",\n",
    "    \"    print(f'  {s}/ : {n:4d} images  {bar}')\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# ── 6. Vérification GPU ────────────────────────────────────────────────────\\n\",\n",
    "    \"import tensorflow as tf\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f'TensorFlow {tf.__version__}')\\n\",\n",
    "    \"gpus = tf.config.list_physical_devices('GPU')\\n\",\n",
    "    \"if gpus:\\n\",\n",
    "    \"    print(f'[OK] GPU : {gpus[0].name}')\\n\",\n",
    "    \"    tf.config.experimental.set_memory_growth(gpus[0], True)\\n\",\n",
    "    \"else:\\n\",\n",
    "    \"    print('[!] Aucun GPU détecté → Runtime → Change runtime type → GPU T4')\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# ── 7a. CNN Baseline (4 classes, Focal Loss) ───────────────────────────────\\n\",\n",
    "    \"# Durée estimée : ~15 min sur T4\\n\",\n",
    "    \"!python src/train_4classes.py --loss focal --epochs 50\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# ── 7b. Transfer Learning EfficientNetB0 (4 classes) ──────────────────────\\n\",\n",
    "    \"# Phase 1 : Feature Extraction (backbone gelé)\\n\",\n",
    "    \"# Phase 2 : Fine-Tuning (40 dernières couches, lr=5e-6)\\n\",\n",
    "    \"# Durée estimée : ~45 min sur T4\\n\",\n",
    "    \"!python src/train_4classes_tl.py \\\\\\n\",\n",
    "    \"    --backbone efficientnetb0 \\\\\\n\",\n",
    "    \"    --phase1-epochs 30 \\\\\\n\",\n",
    "    \"    --phase2-epochs 25 \\\\\\n\",\n",
    "    \"    --loss focal\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# ── 8. Courbes d'entraînement ──────────────────────────────────────────────\\n\",\n",
    "    \"from IPython.display import Image as IPImage, display\\n\",\n",
    "    \"import os\\n\",\n",
    "    \"\\n\",\n",
    "    \"for fname in sorted(os.listdir('models')):\\n\",\n",
    "    \"    if fname.endswith('_history.png'):\\n\",\n",
    "    \"        print(f'\\\\n--- {fname} ---')\\n\",\n",
    "    \"        display(IPImage(filename=f'models/{fname}', width=900))\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# ── 9. Évaluation clinique ─────────────────────────────────────────────────\\n\",\n",
    "    \"!python src/evaluate.py \\\\\\n\",\n",
    "    \"    --model models/tl_4classes_efficientnetb0_final.keras\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# ── 10. Visualisation des résultats ───────────────────────────────────────\\n\",\n",
    "    \"from IPython.display import Image as IPImage, display\\n\",\n",
    "    \"import os\\n\",\n",
    "    \"\\n\",\n",
    "    \"for fname in sorted(os.listdir('reports')):\\n\",\n",
    "    \"    if fname.endswith('_metrics.txt'):\\n\",\n",
    "    \"        print(f'\\\\n{\\\"=\\\"*60}\\\\n{fname}\\\\n{\\\"=\\\"*60}')\\n\",\n",
    "    \"        with open(f'reports/{fname}', 'r') as f:\\n\",\n",
    "    \"            print(f.read())\\n\",\n",
    "    \"\\n\",\n",
    "    \"for fname in sorted(os.listdir('reports')):\\n\",\n",
    "    \"    if fname.endswith(('.png',)) and 'gradcam' not in fname:\\n\",\n",
    "    \"        print(f'\\\\n--- {fname} ---')\\n\",\n",
    "    \"        display(IPImage(filename=f'reports/{fname}', width=700))\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# ── 11. Grad-CAM (Explicabilité XAI) ─────────────────────────────────────\\n\",\n",
    "    \"!python src/gradcam.py \\\\\\n\",\n",
    "    \"    --model models/tl_4classes_efficientnetb0_final.keras \\\\\\n\",\n",
    "    \"    --samples 5\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# ── 12. Galerie Grad-CAM ──────────────────────────────────────────────────\\n\",\n",
    "    \"from IPython.display import Image as IPImage, display\\n\",\n",
    "    \"import os\\n\",\n",
    "    \"\\n\",\n",
    "    \"gradcam_dir = 'reports/gradcam'\\n\",\n",
    "    \"if os.path.isdir(gradcam_dir):\\n\",\n",
    "    \"    for fname in sorted(os.listdir(gradcam_dir))[:5]:\\n\",\n",
    "    \"        if fname.endswith('.png'):\\n\",\n",
    "    \"            print(f'\\\\n--- {fname} ---')\\n\",\n",
    "    \"            display(IPImage(filename=f'{gradcam_dir}/{fname}', width=800))\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# ── 13. Auto-Encodeur (Anomalies) — Optionnel ─────────────────────────────\\n\",\n",
    "    \"!python src/autoencoder.py --train --epochs 30\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# ── 14. Récapitulatif ─────────────────────────────────────────────────────\\n\",\n",
    "    \"import os\\n\",\n",
    "    \"\\n\",\n",
    "    \"print('\\\\n' + '='*60)\\n\",\n",
    "    \"print('  MODÈLES ENTRAÎNÉS')\\n\",\n",
    "    \"print('='*60)\\n\",\n",
    "    \"for f in sorted(os.listdir('models')):\\n\",\n",
    "    \"    if f.endswith(('.keras', '.h5')):\\n\",\n",
    "    \"        size = os.path.getsize(f'models/{f}') / 1e6\\n\",\n",
    "    \"        print(f'  {f:50s}  {size:.1f} MB')\\n\",\n",
    "    \"\\n\",\n",
    "    \"print('\\\\n' + '='*60)\\n\",\n",
    "    \"print('  RAPPORTS')\\n\",\n",
    "    \"print('='*60)\\n\",\n",
    "    \"for f in sorted(os.listdir('reports')):\\n\",\n",
    "    \"    print(f'  {f}')\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# ── 15. Téléchargement du modèle final ────────────────────────────────────\\n\",\n",
    "    \"from google.colab import files\\n\",\n",
    "    \"import os\\n\",\n",
    "    \"\\n\",\n",
    "    \"priority = [\\n\",\n",
    "    \"    'models/tl_4classes_efficientnetb0_final.keras',\\n\",\n",
    "    \"    'models/cnn_4classes_best.keras',\\n\",\n",
    "    \"    'models/cnn_baseline_best.keras',\\n\",\n",
    "    \"]\\n\",\n",
    "    \"for path in priority:\\n\",\n",
    "    \"    if os.path.exists(path):\\n\",\n",
    "    \"        files.download(path)\\n\",\n",
    "    \"        print(f'[OK] Téléchargement : {path}')\\n\",\n",
    "    \"        break\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# ── 16. Téléchargement archive rapports ───────────────────────────────────\\n\",\n",
    "    \"import zipfile, os\\n\",\n",
    "    \"from google.colab import files\\n\",\n",
    "    \"\\n\",\n",
    "    \"zip_path = '/content/brain_tumor_results.zip'\\n\",\n",
    "    \"with zipfile.ZipFile(zip_path, 'w', zipfile.ZIP_DEFLATED) as zipf:\\n\",\n",
    "    \"    for root, dirs, files_l in os.walk('reports'):\\n\",\n",
    "    \"        for fname in files_l:\\n\",\n",
    "    \"            zipf.write(os.path.join(root, fname))\\n\",\n",
    "    \"    for fname in os.listdir('models'):\\n\",\n",
    "    \"        if fname.endswith(('.png', '.txt')):\\n\",\n",
    "    \"            zipf.write(f'models/{fname}')\\n\",\n",
    "    \"\\n\",\n",
    "    \"files.download(zip_path)\\n\",\n",
    "    \"print('[OK] Archive : brain_tumor_results.zip')\"\n",
    "   ]\n",
    "  }\n",
    " ]\n",
